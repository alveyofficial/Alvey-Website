# ─── Firebase ────────────────────────────────────────────────────────────────
# These values are safe to expose client-side. Firebase restricts access via
# Security Rules and authorized domains, not by keeping the config secret.
# Copy this file to .env and fill in your values.

VITE_FIREBASE_API_KEY=AIzaSyD2wBtozKXsTu7UakF9_VxU6Vb2QDd_zfo
VITE_FIREBASE_AUTH_DOMAIN=alvey-website.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=alvey-website
VITE_FIREBASE_STORAGE_BUCKET=alvey-website.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1020096383368
VITE_FIREBASE_APP_ID=1:1020096383368:web:5aacf2315e30648042923d
VITE_FIREBASE_MEASUREMENT_ID=G-JPFY32QJR1
# Firebase Cloud Messaging (FCM) VAPID key — required for browser push notifications
VITE_FIREBASE_VAPID_KEY=

# ─── AI Chatbot Function ─────────────────────────────────────────────────────
# URL of the deployed alvey-ai-brain Cloud Function
AI_FUNCTION_URL=

# Gemini API key — used by the alvey-ai-brain Cloud Function (server-side only).
# Get yours from: https://aistudio.google.com/app/apikey
# Set this in Firebase Console → Functions → alveyAiBrain → Environment variables
# for production. For local emulator, add it to functions/alvey-ai-brain/.env
GEMINI_API_KEY=

# URL of the website-notifications Cloud Function (contact form, applications, etc.)
# After deploying, Firebase prints this URL — it looks like:
# https://us-central1-alvey-website.cloudfunctions.net/websiteNotifications
VITE_NOTIFICATIONS_FUNCTION_URL=https://us-central1-alvey-website.cloudfunctions.net/websiteNotifications

