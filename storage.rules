rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function bookingData(bookingId) {
      return firestore.get(
        /databases/(default)/documents/bookings/$(bookingId)
      ).data;
    }

    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.admin == true
          || firestore.get(
            /databases/(default)/documents/users/$(request.auth.uid)
          ).data.role == 'admin'
        );
    }

    function isBookingStudent(bookingId) {
      return request.auth != null
        && bookingData(bookingId).studentId == request.auth.uid;
    }

    match /booking-receipts/{bookingId}/{fileName} {

      // Only the student who owns the booking can upload,
      // and only while payment is awaiting verification.
      allow create: if isBookingStudent(bookingId)
        && bookingData(bookingId).status == 'awaiting_payment'
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'application/pdf'
        ];

      // The booking's student and admins can view its receipt.
      allow read: if isBookingStudent(bookingId) || isAdmin();

      // No replacing or deleting uploaded receipts through the client.
      allow update, delete: if false;
    }
  }
}
